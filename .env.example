# Browser-safe Supabase configuration used by Vite.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
VITE_ALLOWED_EMAIL_DOMAIN=students.kasralainy.edu.eg

# Server-only Vercel variables for /api/ai. Never prefix secrets with VITE_.
# Shared AI stays off unless AI_PROXY_ENABLED is exactly true and the Batch 1
# Supabase migration (including consume_ai_quota) has been deployed.
AI_PROXY_ENABLED=false
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
ANTHROPIC_API_KEY=YOUR_SERVER_ONLY_KEY

# Administrator publishing script (scripts/upload-content.ts). Set this only in
# your local terminal; never in a VITE_ variable or committed .env file.
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# Standalone legacy study-hub service. Keep these while render.yaml still points
# at that service; confirm deployment usage before removing them.
PORT=3000
SESSION_SECRET=YOUR_LONG_RANDOM_COOKIE_SIGNING_SECRET
COOKIE_SECURE=0
ADMIN_INVITE_CODE=YOUR_BOOTSTRAP_INVITE_CODE
